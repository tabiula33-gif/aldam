# Public site URL (used for QPay callback and links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin page password, and a long random string used to sign the admin cookie
ADMIN_PASSWORD=
ADMIN_SECRET=

# QPay merchant API v2. Leave QPAY_USERNAME empty to use the built-in test mode
# (a "simulate payment" button replaces the real QR code).
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# Only for a public demo deployment without QPay: lets visitors "pay" with the test button.
# Never set this on the real shop.
ALLOW_TEST_PAYMENTS=
